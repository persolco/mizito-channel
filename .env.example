# Copy to .env and fill in. `.env` is gitignored; never commit real credentials.
# Bun loads .env from the current directory automatically.
# Alternatively run `mizito login` to store credentials in ~/.config/mizito (mode 0600).

# --- Credentials (your own Mizito account) ---
MIZITO_USERNAME=your-username-or-email
MIZITO_PASSWORD=your-password

# --- Optional ---
# Your own Mizito user id. Normally not needed; it is fetched automatically.
# MIZITO_USER_ID=

# Allow sending messages as you (off unless exactly 1). Leave off unless you need it.
# MIZITO_ALLOW_SEND=1

# Allow creating, editing, deleting and commenting on tasks (off unless exactly 1).
# MIZITO_ALLOW_TASK_WRITE=1

# Push new messages into a Claude Code session as channel notifications (off unless exactly 1).
# Requires MIZITO_PUSH_CHATS: comma-separated chat ids or exact chat names to push.
# MIZITO_PUSH=1
# MIZITO_PUSH_CHATS=Team,Another Chat

# Base poll interval in milliseconds (default 10000, minimum 1000).
# MIZITO_POLL_MS=10000

# Where credentials, session token, cursors and name cache are stored (default ~/.config/mizito).
# Avoid pointing this at a fresh directory: it discards the cached session and forces a new login.
# MIZITO_HOME=

# Backend base URL (default https://app.mizito.ir).
# MIZITO_BASE_URL=https://app.mizito.ir
